"""
HMM regime detection with:
  1. BIC-based model selection (states x covariance type)
  2. Initialization stability check (multi-seed)
  3. Walk-forward out-of-sample validation
  4. Independent evaluation against SPY (not in model)
"""

import pandas as pd
import numpy as np
from hmmlearn import hmm
from sklearn.preprocessing import StandardScaler
from itertools import permutations
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
import yfinance as yf
import joblib
import warnings
import os

from config import (
    N_STATES_RANGE, COV_TYPES, N_SEEDS, HMM_ITER,
    WALK_FORWARD_TRAIN_YEARS, WALK_FORWARD_STEP_DAYS,
    SLOPE_WINDOW, REGIME_NAMES, DATA_DIR, MODEL_DIR, FIGURE_DIR, FEATURES
)

warnings.filterwarnings('ignore')


# ============================================
# Helpers
# ============================================

def compute_bic(model, X):
    """BIC = -2*LL + k*ln(n)"""
    ll = model.score(X)
    n_samples = len(X)
    n_features = X.shape[1]
    n_states = model.n_components

    if model.covariance_type == 'full':
        n_cov = n_states * n_features * (n_features + 1) // 2
    elif model.covariance_type == 'diag':
        n_cov = n_states * n_features
    else:  # tied
        n_cov = n_features * (n_features + 1) // 2

    n_params = (
        n_states * n_features          # means
        + n_cov                        # covariance
        + n_states * (n_states - 1)    # transitions (rows sum to 1)
    )
    return -2 * ll + n_params * np.log(n_samples)


def fit_hmm(X, n_states, cov_type, seed):
    m = hmm.GaussianHMM(
        n_components=n_states,
        covariance_type=cov_type,
        n_iter=HMM_ITER,
        random_state=seed,
        verbose=False
    )
    m.fit(X)
    return m


def best_perm_agreement(a, b, n_states):
    """Max label agreement across all permutations."""
    best = 0
    for perm in permutations(range(n_states)):
        mapped = np.array([perm[x] for x in b])
        best = max(best, np.mean(a == mapped))
    return best


def label_regimes(model, X_scaled, market):
    """Assign interpretable names by sorting regimes on raw VIX mean."""
    labels = model.predict(X_scaled)
    n_states = model.n_components

    regime_vix = {r: market['vix'].values[labels == r].mean() for r in range(n_states)}
    sorted_by_vix = sorted(regime_vix, key=regime_vix.get)

    names = REGIME_NAMES.get(n_states, [f'Regime-{i}' for i in range(n_states)])
    name_map = {sorted_by_vix[i]: names[i] for i in range(n_states)}

    return labels, name_map


# ============================================
# 1. Model Selection
# ============================================

def select_model(X_scaled):
    """BIC grid search across states and covariance types."""
    rows = []
    for n_states in N_STATES_RANGE:
        for cov_type in COV_TYPES:
            bics = []
            for seed in range(10):
                m = fit_hmm(X_scaled, n_states, cov_type, seed)
                bics.append(compute_bic(m, X_scaled))
            rows.append({
                'n_states': n_states,
                'cov_type': cov_type,
                'bic_mean': np.mean(bics),
                'bic_std': np.std(bics),
            })

    df = pd.DataFrame(rows).sort_values('bic_mean')
    print("Model Selection (BIC, lower = better):")
    print(df.to_string(index=False))

    best = df.iloc[0]
    print(f"\nBest: {int(best['n_states'])} states, {best['cov_type']}")
    return int(best['n_states']), best['cov_type'], df


# ============================================
# 2. Stability Check
# ============================================

def check_stability(X_scaled, n_states, cov_type):
    """Fit across N_SEEDS seeds, check label agreement among top performers."""
    seed_runs = []
    for seed in range(N_SEEDS):
        m = fit_hmm(X_scaled, n_states, cov_type, seed)
        seed_runs.append((seed, m.score(X_scaled), m))

    seed_runs.sort(key=lambda x: -x[1])
    top = seed_runs[:5]

    top_labels = [m.predict(X_scaled) for _, _, m in top]
    agreements = []
    for i in range(len(top_labels)):
        for j in range(i + 1, len(top_labels)):
            agreements.append(best_perm_agreement(top_labels[i], top_labels[j], n_states))

    print(f"\nStability ({N_SEEDS} seeds, top 5):")
    print(f"  Agreement: {np.mean(agreements):.1%} +/- {np.std(agreements):.1%}")
    print(f"  Best seed: {top[0][0]} (LL: {top[0][1]:.2f})")

    return top[0][2]  # best model


# ============================================
# 3. Walk-Forward Validation
# ============================================

def walk_forward(market, n_states, cov_type):
    """
    Train on expanding window, predict next quarter out-of-sample.
    Returns OOS labels aligned to market index.
    """
    min_train = WALK_FORWARD_TRAIN_YEARS * 252
    step = WALK_FORWARD_STEP_DAYS

    oos_labels = pd.Series(index=market.index, dtype=float)
    oos_labels[:] = np.nan

    t = min_train
    step_num = 0
    while t < len(market):
        end = min(t + step, len(market))

        train_raw = market.iloc[:t]
        test_raw = market.iloc[t:end]

        # Fresh scaler per window (no lookahead)
        scaler = StandardScaler()
        X_train = scaler.fit_transform(train_raw)
        X_test = scaler.transform(test_raw)

        # Fit on train, predict on test
        best_m, best_ll = None, -np.inf
        for seed in range(5):
            m = fit_hmm(X_train, n_states, cov_type, seed)
            ll = m.score(X_train)
            if ll > best_ll:
                best_m, best_ll = m, ll

        oos_labels.iloc[t:end] = best_m.predict(X_test)
        step_num += 1
        if step_num % 10 == 0:
            print("  Step " + str(step_num))
        t = end

    # Align OOS regime names using VIX (same logic as in-sample)
    valid = oos_labels.dropna().astype(int)
    regime_vix = {r: market.loc[valid.index[valid == r], 'vix'].mean() for r in range(n_states)}
    sorted_by_vix = sorted(regime_vix, key=regime_vix.get)
    names = REGIME_NAMES.get(n_states, [f'Regime-{i}' for i in range(n_states)])
    name_map = {sorted_by_vix[i]: names[i] for i in range(n_states)}

    return valid, name_map


# ============================================
# 4. Evaluation (SPY returns - independent of model)
# ============================================

def evaluate(market, labels, name_map, spy_ret, label_source='In-Sample'):
    """Print regime stats using SPY returns that were NOT in the model."""
    print(f"\nRegime Characteristics ({label_source}):")
    print(f"  {'Regime':<18s} {'Days':>6s} {'Pct':>6s} {'VIX':>7s} {'HY Sprd':>8s} {'SPY 5d':>8s}")
    print(f"  {'-'*54}")

    for regime_id in sorted(name_map.keys()):
        name = name_map[regime_id]
        mask = labels == regime_id
        idx = labels.index[mask] if hasattr(labels, 'index') else market.index[mask]
        n = mask.sum()
        pct = n / len(labels) * 100

        vix_mean = market.loc[idx, 'vix'].mean()
        hy_mean = market.loc[idx, 'hy_spread'].mean()
        spy_mean = spy_ret.reindex(idx).mean() * 100

        print(f"  {name:<18s} {n:>6d} {pct:>5.1f}% {vix_mean:>7.1f} {hy_mean:>7.2f}% {spy_mean:>+7.2f}%")


# ============================================
# 5. Plots
# ============================================

def plot_regime_history(market, labels, name_map, spy, title_suffix=''):
    """Regime shading over SPY price."""
    colors = {'Low-Risk': 'green', 'Elevated-Risk': 'gold', 'Crisis': 'red',
              'Moderate': 'dodgerblue'}
    alphas = {'Low-Risk': 0.15, 'Elevated-Risk': 0.2, 'Crisis': 0.3,
              'Moderate': 0.15}

    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(16, 10), sharex=True)

    spy_aligned = spy.reindex(market.index, method='ffill').dropna()
    ax1.plot(spy_aligned.index, spy_aligned, 'k-', linewidth=0.7)

    label_series = pd.Series(labels, index=market.index[:len(labels)])

    for regime_id, name in name_map.items():
        mask = label_series == regime_id
        blocks = _get_blocks(mask)
        for s, e in blocks:
            ax1.axvspan(market.index[s], market.index[e],
                        alpha=alphas.get(name, 0.2), color=colors.get(name, 'gray'))

    ax1.set_ylabel('SPY')
    ax1.set_title(f'Market Regimes {title_suffix}', fontsize=13, fontweight='bold')
    ax1.grid(alpha=0.3)
    ax1.legend(
        handles=[Patch(facecolor=colors.get(n, 'gray'), alpha=0.3, label=n) for n in name_map.values()],
        loc='upper left'
    )

    ax2.plot(market.index, market['vix'], 'b-', linewidth=0.6)
    ax2.axhline(20, color='orange', linestyle='--', alpha=0.5)
    ax2.axhline(30, color='red', linestyle='--', alpha=0.5)
    ax2.set_ylabel('VIX')
    ax2.set_xlabel('Date')
    ax2.grid(alpha=0.3)

    plt.tight_layout()
    return fig


def plot_regime_probabilities(market, model, X_scaled, name_map):
    """Stacked area chart of regime probabilities."""
    probs = model.predict_proba(X_scaled)
    colors = {'Low-Risk': 'green', 'Elevated-Risk': 'gold', 'Crisis': 'red',
              'Moderate': 'dodgerblue'}

    # Sort columns by risk level for clean stacking
    ordered = sorted(name_map.keys(), key=lambda r: list(name_map.values()).index(name_map[r]))

    fig, ax = plt.subplots(figsize=(16, 5))
    bottom = np.zeros(len(market))

    for regime_id in ordered:
        name = name_map[regime_id]
        ax.fill_between(market.index, bottom, bottom + probs[:, regime_id],
                        alpha=0.6, color=colors.get(name, 'gray'), label=name)
        bottom += probs[:, regime_id]

    ax.set_ylabel('Probability')
    ax.set_xlabel('Date')
    ax.set_title('Regime Probabilities', fontsize=13, fontweight='bold')
    ax.legend(loc='upper left')
    ax.grid(alpha=0.3)
    plt.tight_layout()
    return fig


def plot_current_state(market, model, X_scaled, name_map):
    """Current regime bar chart + last 90d pie."""
    probs = model.predict_proba(X_scaled)
    labels = model.predict(X_scaled)

    colors = {'Low-Risk': 'green', 'Elevated-Risk': 'gold', 'Crisis': 'red',
              'Moderate': 'dodgerblue'}

    current_probs = probs[-1]
    current_date = market.index[-1].date()

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))

    # Bar chart
    ordered = sorted(name_map.keys(), key=lambda r: list(name_map.values()).index(name_map[r]))
    bar_names = [name_map[r] for r in ordered]
    bar_vals = [current_probs[r] for r in ordered]
    bar_colors = [colors.get(n, 'gray') for n in bar_names]

    ax1.bar(bar_names, bar_vals, color=bar_colors, alpha=0.7)
    ax1.set_ylabel('Probability')
    ax1.set_title(f'Current Regime ({current_date})', fontweight='bold')
    ax1.set_ylim(0, 1)
    ax1.grid(axis='y', alpha=0.3)
    for i, v in enumerate(bar_vals):
        ax1.text(i, v + 0.02, f'{v:.0%}', ha='center', fontsize=11)

    # Pie (last 90 days)
    recent_labels = labels[-90:]
    name_series = pd.Series([name_map[l] for l in recent_labels])
    counts = name_series.value_counts()

    ax2.pie(counts, labels=counts.index, autopct='%1.0f%%',
            colors=[colors.get(n, 'gray') for n in counts.index], startangle=90)
    ax2.set_title('Last 90 Days', fontweight='bold')

    plt.tight_layout()
    return fig


def _get_blocks(mask):
    """Return (start, end) index pairs for contiguous True blocks."""
    blocks = []
    in_block = False
    for i, val in enumerate(mask):
        if val and not in_block:
            start = i
            in_block = True
        elif not val and in_block:
            blocks.append((start, i - 1))
            in_block = False
    if in_block:
        blocks.append((start, len(mask) - 1))
    return blocks


# ============================================
# Main
# ============================================

def train():
    os.makedirs(FIGURE_DIR, exist_ok=True)

    market = pd.read_csv(f'{DATA_DIR}/market_data.csv', index_col=0, parse_dates=True)
    X_scaled = pd.read_csv(f'{DATA_DIR}/features_scaled.csv', index_col=0, parse_dates=True)

    spy = yf.download('SPY', start=market.index.min(), end=market.index.max(), progress=False)['Close'].squeeze()
    spy_ret = spy.pct_change(5).reindex(market.index)

    # 1. Model selection
    n_states, cov_type, bic_df = select_model(X_scaled.values)

    # 2. Stability
    model = check_stability(X_scaled.values, n_states, cov_type)

    # 3. In-sample labeling
    labels, name_map = label_regimes(model, X_scaled.values, market)
    evaluate(market, pd.Series(labels, index=market.index), name_map, spy_ret, 'In-Sample')

    # 4. Walk-forward OOS
    print("\nWalk-Forward Validation:")
    oos_labels, oos_name_map = walk_forward(market, n_states, cov_type)
    evaluate(market, oos_labels, oos_name_map, spy_ret, 'Out-of-Sample')

    # 5. Transition matrix
    print("\nTransition Matrix:")
    trans = pd.DataFrame(
        model.transmat_,
        columns=[name_map[i] for i in range(n_states)],
        index=[name_map[i] for i in range(n_states)]
    )
    print(trans.round(3))

    for r, name in name_map.items():
        p = model.transmat_[r, r]
        avg_dur = 1 / (1 - p) if p < 1 else np.inf
        print(f"  {name}: persistence {p:.1%}, avg duration {avg_dur:.0f} days")

    # 6. Save
    results = market.copy()
    results['regime'] = labels
    results['regime_name'] = [name_map[l] for l in labels]
    probs = model.predict_proba(X_scaled.values)
    for r, name in name_map.items():
        results[f'prob_{name}'] = probs[:, r]
    results.to_csv(f'{DATA_DIR}/regime_results.csv')

    joblib.dump(model, f'{MODEL_DIR}/hmm_model.pkl')
    bic_df.to_csv(f'{DATA_DIR}/bic_selection.csv', index=False)

    # 7. Plots
    fig = plot_regime_history(market, labels, name_map, spy, '(In-Sample)')
    fig.savefig(f'{FIGURE_DIR}/regime_history.png', dpi=150)

    fig = plot_regime_probabilities(market, model, X_scaled.values, name_map)
    fig.savefig(f'{FIGURE_DIR}/regime_probabilities.png', dpi=150)

    fig = plot_current_state(market, model, X_scaled.values, name_map)
    fig.savefig(f'{FIGURE_DIR}/current_regime.png', dpi=150)

    # OOS plot
    fig = plot_regime_history(
        market.loc[oos_labels.index],
        oos_labels.values,
        oos_name_map,
        spy,
        '(Out-of-Sample)'
    )
    fig.savefig(f'{FIGURE_DIR}/regime_history_oos.png', dpi=150)

    plt.show()
    plt.close('all')

    # 8. Summary
    current = results.iloc[-1]
    print(f"\nCurrent State ({market.index[-1].date()}):")
    print(f"  Regime: {current['regime_name']}")
    print(f"  VIX: {current['vix']:.1f} | HY Spread: {current['hy_spread']:.2f}%")

    return model, results


if __name__ == '__main__':
    import yfinance as yf
    train()
